    "cues": [
      {
        "cue": "2",
        "start": "00:03:37,700",
        "end": "00:03:42,000",
        "text": "今年のサラダナはダメでした。"
      },
      {
        "cue": "1",
        "start": "00:03:49,200",
        "end": "00:03:53,500",
        "text": "ダイコンも失敗です。"
      },
      {
        "cue": "2",
        "start": "00:03:53,700",
        "end": "00:03:58,000",
        "text": "収穫時期を見越して種まきしましたが、"
      },
      {
        "cue": "3",
        "start": "00:03:58,200",
        "end": "00:04:02,500",
        "text": "気候が安定せず計算通りにいきませんでした。"
      }
    ]
  },
  {
    "id": "n152",
    "code": "n152",
    "title": "1mの共生畑 第1回",
