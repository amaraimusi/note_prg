[
  {
    "id": "n118",
    "code": "n118",
    "title": "ダイコン混合播種と秋の発芽不良",
    "period": "2024年9月中旬〜10月中旬",
    "period_evidence": "本文の場面表示に基づく。年は更新日から推定。",
    "representative_file": "n118ja.srt",
    "cues": [
      {
        "cue": "1",
        "start": "00:00:00,200",
        "end": "00:00:04,200",
        "text": "9月中旬"
      },
      {
        "cue": "2",
        "start": "00:00:04,400",
        "end": "00:00:08,400",
        "text": "自然農と協生農法の畑です。"
      },
      {
        "cue": "3",
        "start": "00:00:08,600",
        "end": "00:00:12,600",
        "text": "ダイコンのタネを蒔く準備をしています。"
      },
      {
        "cue": "4",
        "start": "00:00:12,800",
        "end": "00:00:16,800",
        "text": "先日のことですが、草を刈ったあと、"
      },
      {
        "cue": "5",
        "start": "00:00:17,000",
        "end": "00:00:21,000",
        "text": "刈草の上から堆肥で補いをしました。"
      },
      {
        "cue": "2",
        "start": "00:00:27,700",
        "end": "00:00:32,000",
        "text": "雑草の芽も少し生え始めているようです。"
      },
      {
        "cue": "1",
        "start": "00:00:37,200",
        "end": "00:00:41,500",
        "text": "この畝全体でダイコンを育てます。"
      },
      {
        "cue": "1",
        "start": "00:00:49,200",
        "end": "00:00:53,500",
        "text": "ダイコンのタネを用意しました。"
      },
      {
        "cue": "2",
        "start": "00:00:53,700",
        "end": "00:00:58,000",
        "text": "この畝の面積は、キリの良い10㎡にしています。"
      },
      {
        "cue": "3",
        "start": "00:00:58,200",
        "end": "00:01:02,500",
        "text": "この10㎡の範囲にタネ20mlをバラまきます。"
      },
      {
        "cue": "1",
        "start": "00:02:24,200",
        "end": "00:02:28,500",
        "text": "６日後。"
      },
      {
        "cue": "2",
        "start": "00:02:28,700",
        "end": "00:02:33,000",
        "text": "ダイコンが発芽したようです。"
      },
      {
        "cue": "3",
        "start": "00:02:33,200",
        "end": "00:02:37,500",
        "text": "枯草のスキマから芽が出ていることが確認できます。"
      },
      {
        "cue": "1",
        "start": "00:02:43,200",
        "end": "00:02:47,500",
        "text": "ダイコンのタネ蒔きから一か月が経過し、"
      },
      {
        "cue": "2",
        "start": "00:02:47,700",
        "end": "00:02:52,000",
        "text": "10月中旬になりました。"
      },
      {
        "cue": "3",
        "start": "00:02:52,200",
        "end": "00:02:56,500",
        "text": "今年の秋はタネが発芽しない事例が各地で発生。"
      },
      {
        "cue": "4",
        "start": "00:02:56,700",
        "end": "00:03:01,000",
        "text": "私の畑も例外ではありませんでした。"
      },
      {
        "cue": "1",
        "start": "00:03:05,200",
        "end": "00:03:09,500",
        "text": "ダイコン、ニンジン、春菊はどうなったでしょう？"
      },
      {
        "cue": "1",
        "start": "00:03:14,200",
        "end": "00:03:18,500",
        "text": "ダイコンは順調そうです。"
      },
      {
        "cue": "2",
        "start": "00:03:18,700",
        "end": "00:03:23,000",
        "text": "しかし、ニンジンと春菊が見当たりません。"
      },
      {
        "cue": "1",
        "start": "00:03:26,200",
        "end": "00:03:30,500",
        "text": "ニンジンと春菊はモンシロチョウの幼虫対策でした。"
      },
      {
        "cue": "1",
        "start": "00:15:34,200",
        "end": "00:15:38,500",
        "text": "また、やらかしました。"
      },
      {
        "cue": "2",
        "start": "00:15:38,700",
        "end": "00:15:43,000",
        "text": "収穫が遅れ、シカクマメの実を肥大化させてしまった。"
      },
      {
        "cue": "1",
        "start": "00:15:46,200",
        "end": "00:15:50,500",
        "text": "この場所のモロヘイヤも収穫できません。"
      },
      {
        "cue": "2",
        "start": "00:15:50,700",
        "end": "00:15:55,000",
        "text": "見た目からして毒化しています。"
      }
    ]
  },
  {
    "id": "n120",
    "code": "n120",
    "title": "暑い秋の混植と続く夏野菜収穫",
    "period": "2024年10月中旬〜下旬（回顧：9月）",
    "period_evidence": "冒頭10月中旬から下旬。年は更新日から推定。",
    "representative_file": "n120ja.srt",
    "cues": [
      {
        "cue": "1",
        "start": "00:02:36,200",
        "end": "00:02:40,500",
        "text": "時を遡り、"
      },
      {
        "cue": "2",
        "start": "00:02:40,700",
        "end": "00:02:45,000",
        "text": "一か月前の9月中旬。"
      },
      {
        "cue": "3",
        "start": "00:02:45,200",
        "end": "00:02:49,500",
        "text": "シマトウガラシが実を付け始めました。"
      },
      {
        "cue": "1",
        "start": "00:02:59,200",
        "end": "00:03:03,500",
        "text": "隣にはショウガが植えてあります。"
      },
      {
        "cue": "1",
        "start": "00:08:41,200",
        "end": "00:08:45,500",
        "text": "本日の収穫物。"
      },
      {
        "cue": "1",
        "start": "00:08:48,200",
        "end": "00:08:52,500",
        "text": "ダイコンを育てているはずの場所です。"
      },
      {
        "cue": "1",
        "start": "00:08:55,200",
        "end": "00:08:59,500",
        "text": "すっかり草だらけです。"
      },
      {
        "cue": "1",
        "start": "00:09:04,200",
        "end": "00:09:08,500",
        "text": "草ばかり見えますが、"
      },
      {
        "cue": "2",
        "start": "00:09:08,700",
        "end": "00:09:13,000",
        "text": "この畝にはダイコンを育てています。"
      },
      {
        "cue": "3",
        "start": "00:09:13,200",
        "end": "00:09:17,500",
        "text": "先月9月、"
      },
      {
        "cue": "4",
        "start": "00:09:17,700",
        "end": "00:09:22,000",
        "text": "ダイコン、ニンジン、春菊を混ぜて蒔きましたが、"
      },
      {
        "cue": "5",
        "start": "00:09:22,200",
        "end": "00:09:26,500",
        "text": "生えてきたのはダイコンだけでした。"
      },
      {
        "cue": "6",
        "start": "00:09:26,700",
        "end": "00:09:31,000",
        "text": "暑すぎたのです。"
      },
      {
        "cue": "7",
        "start": "00:09:31,200",
        "end": "00:09:35,500",
        "text": "高温休眠状態になってしまったのでしょう。"
      },
      {
        "cue": "8",
        "start": "00:09:35,700",
        "end": "00:09:40,000",
        "text": "ニンジン、春菊は発芽しませんでした。"
      },
      {
        "cue": "9",
        "start": "00:09:40,200",
        "end": "00:09:44,500",
        "text": "ダイコンも暑さに負けている感じで、"
      },
      {
        "cue": "10",
        "start": "00:09:44,700",
        "end": "00:09:49,000",
        "text": "全体的に弱々しいです。"
      },
      {
        "cue": "1",
        "start": "00:09:51,200",
        "end": "00:09:55,500",
        "text": "ダイコンの様子を詳しく見てみます。"
      },
      {
        "cue": "2",
        "start": "00:09:55,700",
        "end": "00:10:00,000",
        "text": "葉の色が薄く、"
      },
      {
        "cue": "3",
        "start": "00:10:00,200",
        "end": "00:10:04,500",
        "text": "勢いがありません。"
      },
      {
        "cue": "1",
        "start": "00:10:18,200",
        "end": "00:10:22,500",
        "text": "手で草を抜くことにしたところ、"
      },
      {
        "cue": "2",
        "start": "00:10:22,700",
        "end": "00:10:27,000",
        "text": "ダイコンにまでダメージが入るので中止しました。"
      },
      {
        "cue": "1",
        "start": "00:10:29,200",
        "end": "00:10:33,500",
        "text": "このあたりのダイコンは全滅し、草だらけです。"
      },
      {
        "cue": "1",
        "start": "00:10:38,200",
        "end": "00:10:42,500",
        "text": "良い草整理方法を思いつきました。"
      },
      {
        "cue": "1",
        "start": "00:10:44,200",
        "end": "00:10:48,500",
        "text": "草刈り機で、上の部分だけ草を刈りました。"
      },
      {
        "cue": "1",
        "start": "00:11:27,200",
        "end": "00:11:31,500",
        "text": "11月中旬になれば気温が25℃前後まで下がるはず。"
      },
      {
        "cue": "2",
        "start": "00:11:31,700",
        "end": "00:11:36,000",
        "text": "その時、ダイコンが強く成長することを期待します。"
      },
      {
        "cue": "1",
        "start": "00:11:40,200",
        "end": "00:11:44,500",
        "text": "ここからは猫たちの様子です。"
      },
      {
        "cue": "2",
        "start": "00:11:44,700",
        "end": "00:11:49,000",
        "text": "ひさしぶりの静かな時間です。"
      }
    ]
  },
  {
    "id": "n125",
    "code": "n125",
    "title": "冬のダイコン・ニンジン・コマツナ混合播種",
    "period": "2024年11月下旬",
    "period_evidence": "冒頭「2024年11月下旬」。年月は本文に明記。",
    "representative_file": "n125ja.srt",
    "cues": [
      {
        "cue": "1",
        "start": "00:00:00,200",
        "end": "00:00:05,000",
        "text": "2024年11月下旬"
      },
      {
        "cue": "2",
        "start": "00:00:05,200",
        "end": "00:00:10,000",
        "text": "協生農法と自然農の畑です。"
      },
      {
        "cue": "4",
        "start": "00:00:15,200",
        "end": "00:00:20,000",
        "text": "前回、タネ蒔きした水菜です。"
      },
      {
        "cue": "1",
        "start": "00:02:11,200",
        "end": "00:02:16,000",
        "text": "さて、タネの準備をします。"
      },
      {
        "cue": "2",
        "start": "00:02:16,200",
        "end": "00:02:21,000",
        "text": "まずはダイコンのタネ60ml。"
      },
      {
        "cue": "3",
        "start": "00:02:21,200",
        "end": "00:02:26,000",
        "text": "画面では2袋ですが、3袋用意しました。"
      },
      {
        "cue": "1",
        "start": "00:02:30,200",
        "end": "00:02:35,000",
        "text": "ニンジンのタネ 20ml"
      },
      {
        "cue": "2",
        "start": "00:08:17,700",
        "end": "00:08:22,000",
        "text": "アイデア次第でいろいろな応用ができそうです。"
      },
      {
        "cue": "1",
        "start": "00:08:30,200",
        "end": "00:08:35,000",
        "text": "さて、今現在、11月下旬の協生農法の様子です。"
      },
      {
        "cue": "2",
        "start": "00:08:35,200",
        "end": "00:08:40,000",
        "text": "ゴーヤが実っていますが、"
      },
      {
        "cue": "3",
        "start": "00:08:40,200",
        "end": "00:08:45,000",
        "text": "恐らく最後のゴーヤです。"
      }
    ]
  },
  {
    "id": "n127",
    "code": "n127",
    "title": "不耕起のタマネギ定植とジャガイモ植付け",
    "period": "2024年11月下旬",
    "period_evidence": "冒頭「2024年11月下旬」。年月は本文に明記。",
    "representative_file": "n127ja.srt",
    "cues": [
      {
        "cue": "1",
        "start": "00:00:00,200",
        "end": "00:00:05,000",
        "text": "2024年11月下旬"
      },
      {
        "cue": "2",
        "start": "00:00:05,200",
        "end": "00:00:10,000",
        "text": "自然農と協生農法の畑です。"
      },
      {
        "cue": "3",
        "start": "00:00:10,200",
        "end": "00:00:15,000",
        "text": "タマネギの苗を定植することにしました。"
      },
      {
        "cue": "3",
        "start": "00:05:07,200",
        "end": "00:05:12,000",
        "text": "年明けの2月には収穫できるかもしれません。"
      },
      {
        "cue": "1",
        "start": "00:05:14,200",
        "end": "00:05:19,000",
        "text": "ダイコン、コマツナ、ニンジンなど、"
      },
      {
        "cue": "2",
        "start": "00:05:19,200",
        "end": "00:05:24,000",
        "text": "複数の冬野菜を一緒に栽培している場所です。"
      },
      {
        "cue": "3",
        "start": "00:05:24,200",
        "end": "00:05:29,000",
        "text": "タネ蒔きから16日が経過しました。"
      }
    ]
  },
  {
    "id": "n128",
    "code": "n128",
    "title": "冬の混植とビーツ・カブの播種",
    "period": "2024年12月初旬〜中旬",
    "period_evidence": "冒頭に年と範囲を明記。",
    "representative_file": "n128ja.srt",
    "cues": [
      {
        "cue": "2",
        "start": "00:00:05,200",
        "end": "00:00:10,000",
        "text": "自然農と協生農法の動画へようこそ"
      },
      {
        "cue": "3",
        "start": "00:00:10,200",
        "end": "00:00:15,000",
        "text": "早速ですが草と一緒に\r\n栽培しているダイコンを観察します。"
      },
      {
        "cue": "1",
        "start": "00:00:21,200",
        "end": "00:00:26,000",
        "text": "草に押され埋もれがちのダイコンでしたが、"
      },
      {
        "cue": "2",
        "start": "00:00:26,200",
        "end": "00:00:31,000",
        "text": "周囲の草を押し返し始めました。"
      },
      {
        "cue": "1",
        "start": "00:00:33,200",
        "end": "00:00:38,000",
        "text": "他のダイコンも同じように草を押し返しています。"
      },
      {
        "cue": "2",
        "start": "00:00:38,200",
        "end": "00:00:43,000",
        "text": "一時期、草が長く伸びていましたが、"
      },
      {
        "cue": "3",
        "start": "00:00:43,200",
        "end": "00:00:48,000",
        "text": "先日、草の上部だけ草刈機で刈る方法を思いつき、"
      },
      {
        "cue": "4",
        "start": "00:00:48,200",
        "end": "00:00:53,000",
        "text": "それ以来、定期的に\r\n散髪をするように草をカットしてきました。"
      },
      {
        "cue": "1",
        "start": "00:00:56,200",
        "end": "00:01:01,000",
        "text": "この辺りのダイコンはまだ小さく、"
      },
      {
        "cue": "2",
        "start": "00:01:01,200",
        "end": "00:01:06,000",
        "text": "草のほうが勢いが強そうです。"
      },
      {
        "cue": "3",
        "start": "00:01:06,200",
        "end": "00:01:11,000",
        "text": "このままでは草に埋もれしまうでしょう。"
      },
      {
        "cue": "4",
        "start": "00:01:30,200",
        "end": "00:01:35,000",
        "text": "植物たちは競争したり、共生したりします。"
      },
      {
        "cue": "5",
        "start": "00:01:35,200",
        "end": "00:01:40,000",
        "text": "今回の観察により、ダイコンには、"
      },
      {
        "cue": "6",
        "start": "00:01:40,200",
        "end": "00:01:45,000",
        "text": "周囲の草を押しのける力があることが確認できました。"
      },
      {
        "cue": "7",
        "start": "00:01:45,200",
        "end": "00:01:50,000",
        "text": "ダイコンは大きな雑草には負けますが、"
      },
      {
        "cue": "8",
        "start": "00:01:50,200",
        "end": "00:01:55,000",
        "text": "小さな雑草相手だと勝てるようです。"
      },
      {
        "cue": "1",
        "start": "00:02:01,200",
        "end": "00:02:06,000",
        "text": "とはいえ雑草と野菜を一緒に育てると\r\n良い点もたくさんあります。"
      }
    ]
  },
  {
    "id": "n130",
    "code": "n130",
    "title": "草と共生するダイコンの冬の生育",
    "period": "2024年12月中旬",
    "period_evidence": "冒頭「2024年12月中旬」。年月は本文に明記。",
    "representative_file": "n130ja.srt",
    "cues": [
      {
        "cue": "3",
        "start": "00:00:10,200",
        "end": "00:00:15,000",
        "text": "その隣で雑草と共生させながら"
      },
      {
        "cue": "4",
        "start": "00:00:15,200",
        "end": "00:00:20,000",
        "text": "ダイコンを育てています。"
      },
      {
        "cue": "5",
        "start": "00:00:20,200",
        "end": "00:00:25,000",
        "text": "９月中旬に種まきし、\r\nすでに100日が経過しました。"
      },
      {
        "cue": "1",
        "start": "00:00:29,200",
        "end": "00:00:34,000",
        "text": "本来なら収穫できるくらいの\r\n日数なのですが、いまだに小さい。"
      },
      {
        "cue": "2",
        "start": "00:00:34,200",
        "end": "00:00:39,000",
        "text": "１１月中旬まで続いた\r\n夏のような暑さが原因でしょう。"
      }
    ]
  },
  {
    "id": "n133",
    "code": "n133",
    "title": "0から始める協生農法 第1回",
    "period": "2025年1月頃",
    "period_evidence": "本文「2025年になったので」と1月更新日から月を推定。",
    "representative_file": "n133ja.srt",
    "cues": [
      {
        "cue": "4",
        "start": "00:08:47,200",
        "end": "00:08:52,000",
        "text": "別の畝を土寄せをし、比較することにします。"
      },
      {
        "cue": "1",
        "start": "00:09:05,200",
        "end": "00:09:10,000",
        "text": "120日目のダイコン。"
      },
      {
        "cue": "2",
        "start": "00:09:10,200",
        "end": "00:09:15,000",
        "text": "秋の異常な暑さで、\r\n成長がほとんど止まっていました。"
      },
      {
        "cue": "1",
        "start": "00:09:18,200",
        "end": "00:09:22,800",
        "text": "11月下旬から再成長を始めたダイコン。"
      },
      {
        "cue": "2",
        "start": "00:09:23,000",
        "end": "00:09:27,600",
        "text": "これまで停滞していた分を取り戻しつつあります。"
      },
      {
        "cue": "3",
        "start": "00:09:27,800",
        "end": "00:09:32,400",
        "text": "実質的な成長日数は約70日と考え、"
      },
      {
        "cue": "2",
        "start": "00:11:18,200",
        "end": "00:11:23,000",
        "text": "冬越えできそうですね。新たな発見です。"
      },
      {
        "cue": "1",
        "start": "00:11:26,200",
        "end": "00:11:31,000",
        "text": "この畝は、コマツナ、ダイコン、ニンジンを"
      },
      {
        "cue": "2",
        "start": "00:11:31,200",
        "end": "00:11:36,000",
        "text": "協生農法として混植した場所です。"
      },
      {
        "cue": "3",
        "start": "00:11:36,200",
        "end": "00:11:41,000",
        "text": "50日目でコマツナは収穫期を迎えましたが、"
      }
    ]
  },
  {
    "id": "n137",
    "code": "n137",
    "title": "0から始める協生農法 第5回",
    "period": "2025年2月上旬",
    "period_evidence": "冒頭「2025年2月上旬」。年月は本文に明記。",
    "representative_file": "n137ja.srt",
    "cues": [
      {
        "cue": "6",
        "start": "00:11:21,200",
        "end": "00:11:26,000",
        "text": "順調に育ってるだけにどうしようか迷います。"
      },
      {
        "cue": "1",
        "start": "00:11:29,200",
        "end": "00:11:34,000",
        "text": "続いて、自然農で育てているダイコンです。"
      },
      {
        "cue": "2",
        "start": "00:11:34,200",
        "end": "00:11:39,000",
        "text": "草を取らず、\r\n草刈機で草を整えながら育ててきました。"
      },
      {
        "cue": "3",
        "start": "00:11:39,200",
        "end": "00:11:44,000",
        "text": "9月中旬に種を蒔いたダイコンですが…"
      },
      {
        "cue": "4",
        "start": "00:11:44,200",
        "end": "00:11:49,000",
        "text": "秋の暑さで成長が一時停止しました。"
      },
      {
        "cue": "5",
        "start": "00:11:49,200",
        "end": "00:11:54,000",
        "text": "しかし、11月下旬になって再び成長開始！"
      },
      {
        "cue": "6",
        "start": "00:11:54,200",
        "end": "00:11:59,000",
        "text": "そして、成長再開から80日ほど経過しました。"
      },
      {
        "cue": "7",
        "start": "00:11:59,200",
        "end": "00:12:04,000",
        "text": "いよいよ収穫できる大きさになってきています。"
      },
      {
        "cue": "1",
        "start": "00:12:06,200",
        "end": "00:12:11,000",
        "text": "今日はダイコンを収穫してみます！"
      },
      {
        "cue": "2",
        "start": "00:12:11,200",
        "end": "00:12:16,000",
        "text": "どれくらい立派に育っているでしょうか？"
      },
      {
        "cue": "1",
        "start": "00:12:22,200",
        "end": "00:12:27,000",
        "text": "シャベルを使って少しだけ土を持ち上げます。"
      },
      {
        "cue": "2",
        "start": "00:12:27,200",
        "end": "00:12:32,000",
        "text": "こうすることで、ダイコンはスッと抜けます！"
      },
      {
        "cue": "3",
        "start": "00:12:32,200",
        "end": "00:12:37,000",
        "text": "見事なダイコンですが、少し細めです。"
      },
      {
        "cue": "4",
        "start": "00:12:37,200",
        "end": "00:12:42,000",
        "text": "おそらくこの品種特有の形でしょう。\r\nパッケージにそっくりです。"
      },
      {
        "cue": "5",
        "start": "00:12:42,200",
        "end": "00:12:47,000",
        "text": "ただ、ダイコンの数は少ないです。"
      },
      {
        "cue": "6",
        "start": "00:12:47,200",
        "end": "00:12:52,000",
        "text": "もし気温が25℃を下回る時期に種まきしていたら…"
      },
      {
        "cue": "7",
        "start": "00:12:52,200",
        "end": "00:12:57,000",
        "text": "収穫量はもっと多かったことでしょう。"
      },
      {
        "cue": "6",
        "start": "00:14:14,200",
        "end": "00:14:19,000",
        "text": "これからの協生農法の展開が楽しみです。"
      },
      {
        "cue": "1",
        "start": "00:14:24,200",
        "end": "00:14:29,000",
        "text": "今日はダイコン、コマツナ、シマナを収穫。"
      },
      {
        "cue": "2",
        "start": "00:14:29,200",
        "end": "00:14:34,000",
        "text": "協生農法でもちゃんと収穫できます。"
      },
      {
        "cue": "1",
        "start": "00:14:37,200",
        "end": "00:14:42,000",
        "text": "ここからは猫たちの様子です。"
      }
    ]
  },
  {
    "id": "n139",
    "code": "n139",
    "title": "0から始める協生農法 第7回",
    "period": "2025年2月中旬頃（回顧：2024年12月）",
    "period_evidence": "冒頭2025年2月、本文「２月中旬現在」。缶の日付2011年は撮影年ではない。",
    "representative_file": "n139ja.srt",
    "cues": [
      {
        "cue": "2",
        "start": "00:11:19,200",
        "end": "00:11:24,000",
        "text": "気温にさえ注意すれば、\r\nこんなシンプルな育て方でも育ちます"
      },
      {
        "cue": "1",
        "start": "00:11:30,200",
        "end": "00:11:35,000",
        "text": "コマツナ、ニンジン、ダイコンを混植した畑"
      },
      {
        "cue": "2",
        "start": "00:11:35,200",
        "end": "00:11:40,000",
        "text": "種まきから85日が経過しました"
      },
      {
        "cue": "3",
        "start": "00:11:40,200",
        "end": "00:11:45,000",
        "text": "ダイコンはやがて収穫できそうです"
      },
      {
        "cue": "4",
        "start": "00:11:45,200",
        "end": "00:11:50,000",
        "text": "コマツナはまだ収穫できています"
      },
      {
        "cue": "1",
        "start": "00:11:51,200",
        "end": "00:11:56,000",
        "text": "作りたてのヒューゲルカルチャーの畝"
      }
    ]
  },
  {
    "id": "n143",
    "code": "n143",
    "title": "0から始める協生農法 第10回",
    "period": "2025年2月下旬〜3月（回顧：2024年12月）",
    "period_evidence": "冒頭2024年12月は回顧。主場面は2月下旬から3月。年跨ぎと更新日から推定。",
    "representative_file": "n143ja.srt",
    "cues": [
      {
        "cue": "4",
        "start": "00:05:10,200",
        "end": "00:05:15,000",
        "text": "今日は、さらに葉野菜のタネを追加まきしてみます。"
      },
      {
        "cue": "1",
        "start": "00:05:21,200",
        "end": "00:05:30,000",
        "text": "わさびリーフ、山東菜、モロヘイヤ、ふだん草、\r\nシマナ、春菊、サラダ菜、タアツァイ、\r\nシソ、ダイコン、ニンジン、コマツナ..."
      },
      {
        "cue": "1",
        "start": "00:05:35,200",
        "end": "00:05:40,000",
        "text": "まずは、葉っぱ系の野菜タネだけをミックス。"
      },
      {
        "cue": "2",
        "start": "00:05:40,200",
        "end": "00:05:45,000",
        "text": "葉野菜は暑さに弱いもの多い、"
      },
      {
        "cue": "2",
        "start": "00:08:46,200",
        "end": "00:08:51,000",
        "text": "収穫は7月頃になるでしょう。"
      },
      {
        "cue": "1",
        "start": "00:08:53,200",
        "end": "00:08:58,000",
        "text": "続いては、ダイコン。"
      },
      {
        "cue": "2",
        "start": "00:08:58,200",
        "end": "00:09:03,000",
        "text": "収穫が遅れて、花を咲かせてしまった!"
      },
      {
        "cue": "3",
        "start": "00:09:03,200",
        "end": "00:09:08,000",
        "text": "これは大きな失敗です。"
      },
      {
        "cue": "1",
        "start": "00:09:13,200",
        "end": "00:09:18,000",
        "text": "花が咲いてないダイコンもけっこう残ってますが..."
      },
      {
        "cue": "2",
        "start": "00:09:18,200",
        "end": "00:09:23,000",
        "text": "でも、もう味はだいぶ落ちてるでしょうね。"
      },
      {
        "cue": "1",
        "start": "00:09:25,200",
        "end": "00:09:30,000",
        "text": "原因は、単純に日数でしょう。"
      },
      {
        "cue": "4",
        "start": "00:09:58,200",
        "end": "00:10:03,000",
        "text": "さて、とりあえず収穫です。"
      },
      {
        "cue": "1",
        "start": "00:10:10,200",
        "end": "00:10:15,000",
        "text": "見た目は良いダイコンなんですけどね。"
      },
      {
        "cue": "1",
        "start": "00:10:22,200",
        "end": "00:10:29,000",
        "text": "花の咲いていないダイコンをだけを\r\n掘り出していきます。"
      },
      {
        "cue": "1",
        "start": "00:10:37,200",
        "end": "00:10:42,000",
        "text": "思ったよりもたくさん収穫できました。"
      },
      {
        "cue": "2",
        "start": "00:10:42,200",
        "end": "00:10:47,000",
        "text": "とはいえ、味はイマイチかもしれませんね。"
      },
      {
        "cue": "1",
        "start": "00:10:53,200",
        "end": "00:10:58,000",
        "text": "しかしながら、\r\nこのダイコンから多くを学びを得ました。"
      },
      {
        "cue": "2",
        "start": "00:10:58,200",
        "end": "00:11:03,000",
        "text": "①タネ蒔きの気温の重要性、"
      },
      {
        "cue": "3",
        "start": "00:11:03,200",
        "end": "00:11:08,000",
        "text": "②暑さや寒さで成長は一時停止すること。"
      },
      {
        "cue": "4",
        "start": "00:11:08,200",
        "end": "00:11:14,000",
        "text": "③そして収穫までの日数を意識すること。\r\nこれらの知識は大きな収穫です。"
      },
      {
        "cue": "1",
        "start": "00:11:16,200",
        "end": "00:11:23,000",
        "text": "次はコマツナ、ダイコン、ニンジンを\r\n一緒に混植している畑の様子です。"
      },
      {
        "cue": "2",
        "start": "00:11:23,200",
        "end": "00:11:28,000",
        "text": "種まきから、もうおよそ4カ月です。"
      },
      {
        "cue": "1",
        "start": "00:11:36,200",
        "end": "00:11:41,000",
        "text": "これはニンジンの様子です。"
      },
      {
        "cue": "2",
        "start": "00:11:41,200",
        "end": "00:11:46,000",
        "text": "なかなか大きく育ってくれません。"
      },
      {
        "cue": "3",
        "start": "00:11:46,200",
        "end": "00:11:51,000",
        "text": "すでに120日目を超えます。\r\nこれは失敗ですね。"
      },
      {
        "cue": "4",
        "start": "00:11:51,200",
        "end": "00:11:56,000",
        "text": "ニンジンは混植に弱い野菜なのでしょうか。"
      },
      {
        "cue": "5",
        "start": "00:11:56,200",
        "end": "00:12:01,000",
        "text": "混植のやり方を再検討しなければなりません。"
      },
      {
        "cue": "1",
        "start": "00:12:06,200",
        "end": "00:12:11,000",
        "text": "ダイコンもチェックしてみます。"
      },
      {
        "cue": "2",
        "start": "00:12:11,200",
        "end": "00:12:16,000",
        "text": "混植のせいか、やっぱりちょっと小さいですね。"
      },
      {
        "cue": "3",
        "start": "00:12:16,200",
        "end": "00:12:21,000",
        "text": "同様に120日目を超えてますので、"
      },
      {
        "cue": "4",
        "start": "00:12:21,200",
        "end": "00:12:26,000",
        "text": "すでに収穫のタイミングを逃しています。"
      },
      {
        "cue": "5",
        "start": "00:12:31,200",
        "end": "00:12:36,000",
        "text": "ダイコンとニンジンの混植、\r\n新たな課題が残りました。"
      },
      {
        "cue": "1",
        "start": "00:12:43,200",
        "end": "00:12:48,000",
        "text": "今回、コマツナがとてもよく育ちました。"
      },
      {
        "cue": "2",
        "start": "00:12:48,200",
        "end": "00:12:53,000",
        "text": "大きく元気な株もあれば、"
      }
    ]
  },
  {
    "id": "n142",
    "code": "n142",
    "title": "母の自然農畑、秋から春の収穫",
    "period": "2024年10月初旬〜2025年4月中旬",
    "period_evidence": "秋から年末、春へ連続する場面と4月中旬の追記。年は更新日・前後コードの記録から推定。",
    "representative_file": "n142ja.srt",
    "cues": [
      {
        "cue": "3",
        "start": "00:06:32,200",
        "end": "00:06:37,000",
        "text": "寒くなり、虫たちは不活発に。"
      },
      {
        "cue": "1",
        "start": "00:06:39,200",
        "end": "00:06:44,000",
        "text": "ジャガイモと同じく、ダイコンも成長中。"
      },
      {
        "cue": "2",
        "start": "00:06:44,200",
        "end": "00:06:49,000",
        "text": "沖縄の１２月の平均気温は19～20℃。"
      },
      {
        "cue": "1",
        "start": "00:06:50,200",
        "end": "00:06:55,000",
        "text": "15～20℃でよく育つスナップエンドウ。"
      },
      {
        "cue": "3",
        "start": "00:12:35,200",
        "end": "00:12:39,500",
        "text": "青々しているうちに全部収穫すべきでした。"
      },
      {
        "cue": "1",
        "start": "00:12:40,200",
        "end": "00:12:45,000",
        "text": "冬なのに虫に食べられるダイコン。"
      },
      {
        "cue": "2",
        "start": "00:12:45,200",
        "end": "00:12:50,000",
        "text": "あまり大きくなりそうにないです。"
      },
      {
        "cue": "1",
        "start": "00:12:53,700",
        "end": "00:12:58,000",
        "text": "３週間ほど経過し、3月上旬になりました。"
      },
      {
        "cue": "6",
        "start": "00:13:22,200",
        "end": "00:13:27,000",
        "text": "でも考えてみれば…"
      },
      {
        "cue": "7",
        "start": "00:13:27,200",
        "end": "00:13:32,000",
        "text": "2月末にジャガイモやダイコンを収穫しておけば、"
      },
      {
        "cue": "8",
        "start": "00:13:32,200",
        "end": "00:13:37,000",
        "text": "もう一度冬の葉野菜を育てられたかもしれません。"
      },
      {
        "cue": "9",
        "start": "00:13:37,200",
        "end": "00:13:42,000",
        "text": "わずかな期間のチャンスを見逃したかも。"
      },
      {
        "cue": "1",
        "start": "00:13:52,200",
        "end": "00:13:57,000",
        "text": "とりあえず、ダイコンを収穫することにしました。"
      },
      {
        "cue": "2",
        "start": "00:13:57,200",
        "end": "00:14:02,000",
        "text": "まだ小さいので早すぎるかなと思っていましたが…"
      },
      {
        "cue": "3",
        "start": "00:14:02,200",
        "end": "00:14:07,000",
        "text": "それは大きな勘違いでした。"
      },
      {
        "cue": "4",
        "start": "00:14:07,200",
        "end": "00:14:12,000",
        "text": "すぐにでも収穫せねばならないタイミングでした。"
      },
      {
        "cue": "5",
        "start": "00:14:12,200",
        "end": "00:14:17,000",
        "text": "この先は、ダイコンに筋が入り始めます。"
      },
      {
        "cue": "6",
        "start": "00:14:17,200",
        "end": "00:14:22,000",
        "text": "味もどんどん悪くなっていきます。"
      },
      {
        "cue": "1",
        "start": "00:14:29,200",
        "end": "00:14:34,000",
        "text": "細長いダイコン、引き抜くのに失敗。"
      },
      {
        "cue": "2",
        "start": "00:14:34,200",
        "end": "00:14:39,000",
        "text": "ポキッと折れてしまいました…。"
      },
      {
        "cue": "3",
        "start": "00:14:39,200",
        "end": "00:14:43,000",
        "text": "次はもっと丁寧にやろう。"
      },
      {
        "cue": "5",
        "start": "00:16:11,200",
        "end": "00:16:16,000",
        "text": "病気の心配も、どうやら杞憂で終わりそうです。"
      },
      {
        "cue": "1",
        "start": "00:16:18,200",
        "end": "00:16:23,000",
        "text": "今回の試し掘りでは、\r\nダイコンとジャガイモを収穫。"
      },
      {
        "cue": "2",
        "start": "00:16:23,200",
        "end": "00:16:28,000",
        "text": "なかなか良い感じです。"
      },
      {
        "cue": "1",
        "start": "00:16:31,200",
        "end": "00:16:36,000",
        "text": "ヌマガエルが、葉の陰にひっそりと。"
      },
      {
        "cue": "2",
        "start": "00:17:20,200",
        "end": "00:17:25,000",
        "text": "自然農でも豊作でした。"
      },
      {
        "cue": "1",
        "start": "00:17:28,200",
        "end": "00:17:33,000",
        "text": "ダイコンは収穫が遅すぎました。"
      },
      {
        "cue": "1",
        "start": "00:17:35,200",
        "end": "00:17:40,000",
        "text": "春の海が静かに夕陽を映します。"
      },
      {
        "cue": "2",
        "start": "00:17:40,200",
        "end": "00:17:45,000",
        "text": "砂浜には自然が描いた模様。"
      },
      {
        "cue": "3",
        "start": "00:18:58,200",
        "end": "00:19:03,000",
        "text": "この時期に見るのは珍しい。"
      },
      {
        "cue": "1",
        "start": "00:19:06,200",
        "end": "00:19:11,000",
        "text": "ジャガイモやダイコンを収穫した後の畑。"
      },
      {
        "cue": "2",
        "start": "00:19:11,200",
        "end": "00:19:16,000",
        "text": "しばらく草を生やして土を休ませます。"
      },
      {
        "cue": "1",
        "start": "00:19:21,200",
        "end": "00:19:26,000",
        "text": "倉庫も扉が完成していました。"
      }
    ]
  },
  {
    "id": "n105",
    "code": "n105",
    "title": "年末年始の畑と草管理の反省",
    "period": "2023年12月下旬〜2024年1月初旬",
    "period_evidence": "本文に2023年12月31日と2024年1月1日を明記。",
    "representative_file": "n105ja.srt",
    "cues": [
      {
        "cue": "2",
        "start": "00:00:51,700",
        "end": "00:00:56,000",
        "text": "この季節だと、さすがに虫による食害はありません。"
      },
      {
        "cue": "1",
        "start": "00:00:58,200",
        "end": "00:01:02,500",
        "text": "ダイコン"
      },
      {
        "cue": "2",
        "start": "00:01:02,700",
        "end": "00:01:07,000",
        "text": "草の勢いが強いので大きく成長しないかもしれません。"
      },
      {
        "cue": "1",
        "start": "00:01:12,200",
        "end": "00:01:16,500",
        "text": "勝手に生えてきたジャガイモ。"
      },
      {
        "cue": "1",
        "start": "00:01:43,200",
        "end": "00:01:47,500",
        "text": "母の自然農畑"
      },
      {
        "cue": "1",
        "start": "00:01:54,200",
        "end": "00:01:58,500",
        "text": "ダイコン。"
      },
      {
        "cue": "2",
        "start": "00:01:58,700",
        "end": "00:02:03,000",
        "text": "葉は虫に食べられています。"
      },
      {
        "cue": "3",
        "start": "00:02:03,200",
        "end": "00:02:07,500",
        "text": "今年は暖冬のため虫はまだ活動しているのでしょう。"
      }
    ]
  },
  {
    "id": "n107",
    "code": "n107",
    "title": "混合種まきのやり直しとニンジン収穫",
    "period": "2024年2月中旬〜4月上旬頃",
    "period_evidence": "冒頭2024年2月中旬、播種から約50日後までを収録。",
    "representative_file": "n107ja.srt",
    "cues": [
      {
        "cue": "2",
        "start": "00:01:27,700",
        "end": "00:01:32,000",
        "text": "どのようなタネが混ざっているのか私も把握できていません。"
      },
      {
        "cue": "3",
        "start": "00:01:32,200",
        "end": "00:01:36,500",
        "text": "インゲンマメ、ダイコン、ニンジンなどが混ざっているようです。"
      },
      {
        "cue": "1",
        "start": "00:01:40,200",
        "end": "00:01:44,500",
        "text": "タネは土の上にばらまき、刈草をかぶせて足で踏みます。"
      },
      {
        "cue": "1",
        "start": "00:02:32,200",
        "end": "00:02:36,500",
        "text": "タネまきから約30日後"
      },
      {
        "cue": "1",
        "start": "00:02:47,200",
        "end": "00:02:51,500",
        "text": "ダイコンが生えてきました。"
      },
      {
        "cue": "2",
        "start": "00:02:51,700",
        "end": "00:02:56,000",
        "text": "ニンジンやレタスの小さな苗も散見します。"
      },
      {
        "cue": "1",
        "start": "00:03:01,200",
        "end": "00:03:05,500",
        "text": "これはミツバかな？"
      },
      {
        "cue": "1",
        "start": "00:03:42,200",
        "end": "00:03:46,500",
        "text": "ニンジンも伸びてきています。"
      },
      {
        "cue": "1",
        "start": "00:03:55,200",
        "end": "00:03:59,500",
        "text": "ダイコンも生えていますが、季節外れなのでおそらく育たないでしょう。"
      },
      {
        "cue": "1",
        "start": "00:04:08,200",
        "end": "00:04:12,500",
        "text": "50日前にニンジンを間引きした場所です。"
      },
      {
        "cue": "2",
        "start": "00:04:12,700",
        "end": "00:04:17,000",
        "text": "ニンジンを収穫してみます。"
      }
    ]
  },
  {
    "id": "n108",
    "code": "n108",
    "title": "初夏の混合種まきと発芽観察",
    "period": "2024年5月上旬",
