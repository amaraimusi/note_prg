[
  {
    "id": "n172",
    "title": "夏の畑と秘境の滝探索",
    "period": "2026年7月中旬（年は推定）",
    "period_evidence": "冒頭「7月中旬」。年は更新年・前後の記録から推定。",
    "representative_file": "n172.srt",
    "warnings": "同じコードが異なる分類に存在／時期に推定を含む",
    "excerpts": [
      "2\n00:00:24,200 --> 00:00:29,000\n野菜の成長を妨げている分だけ、\n草をカット。",
      "1\n00:00:31,200 --> 00:00:36,000\nそろそろサツマイモは収穫できるだろうか...",
      "1\n00:00:41,200 --> 00:00:46,000\n試し掘りしてみます。",
      "1\n00:00:51,200 --> 00:00:58,000\n出てきたのは\nツルが生え出た古い芋。",
      "1\n00:01:01,200 --> 00:01:07,000\n別の芋を掘り出してみましたが小さめ。\nもう少し待つことにしてみます。",
      "1\n00:01:09,200 --> 00:01:15,000\n芋を少しでも大きくさせるため、\nツルから出た不定根を外します。",
      "1\n00:01:17,200 --> 00:01:22,000\nイノシシにやられたサツマイモもあります。",
      "2\n00:01:22,200 --> 00:01:27,000\n最近、沖縄ではイノシシを\n目撃することが増えました。",
      "1\n00:01:29,200 --> 00:01:35,000\nでも、壊滅的な被害ではありません。",
      "1\n00:01:38,200 --> 00:01:43,000\nイノシシにやられた跡に\nすぐに次のタネをまきます。",
      "1\n00:01:44,200 --> 00:01:48,000\nミニトマトの収穫シーズンは終了。"
    ],
    "sha256": "2a2ff929ad4c64c3417921b26ce7fd6a899368faeea1f2cfe9b3db85291a8d2f"
  },
  {
    "id": "n171",
    "title": "台風後の四脚支柱補強とネギの肥料比較",
    "period": "2026年6月〜7月初旬（回顧：4月）",
    "period_evidence": "冒頭2026年6月、本文7月初旬の場面を収録。",
    "representative_file": "n171.srt",
    "warnings": "",
    "excerpts": [
      "1\n00:06:45,200 --> 00:06:52,000\n草やショウガにシカクマメのツルが\n巻き付きながら成長中。",
      "1\n00:07:02,200 --> 00:07:10,000\n支柱をつたうシカクマメの下では\n若いサツマイモの株が育っています。",
      "1\n00:07:12,200 --> 00:07:20,000\n複数の野菜を共存させる協生農法...\n最近はちょっといい感じです。",
      "1\n00:07:26,200 --> 00:07:31,000\n刈りバサミで伸びた草だけ切ります。",
      "1\n00:07:45,200 --> 00:07:53,000\n放っておくと草に負けて\nサツマイモの葉は広がらないようです。",
      "2\n00:07:53,200 --> 00:08:01,000\nでも、こうやって刈りバサミで草を整理すると\n葉を広げることができるようです。",
      "1\n00:08:06,200 --> 00:08:11,000\nサツマイモと共生するショウガ。",
      "1\n00:08:12,200 --> 00:08:17,000\n春の時期には\n虫に食べられまくるはずのジャガイモ。",
      "2\n00:08:17,200 --> 00:08:22,000\nこの時期になると虫被害はなくなるようです。\nほっそりと弱々しいですが。",
      "1\n00:08:31,200 --> 00:08:36,000\nミニトマトは長期間に渡り\n実り続けてます。",
      "1\n00:08:38,200 --> 00:08:42,500\nシマトウガラシも収穫シーズン。"
    ],
    "sha256": "864ea1d32bfea5586384a69e6ff394de95e80d7ddaf6b84fcb0fae2c1e72612a"
  },
  {
    "id": "n170",
    "title": "初夏の草整理と四脚支柱",
    "period": "2026年6月初旬",
    "period_evidence": "冒頭「2026年6月初旬」。年月は本文に明記。",
    "representative_file": "n170.srt",
    "warnings": "翻訳・コピー・改訂版を含む",
    "excerpts": [
      "1\n00:00:36,200 --> 00:00:41,000\n草整理が終わりました。",
      "2\n00:00:41,200 --> 00:00:46,000\nちなみにここは\nサツマイモのエリアです。",
      "3\n00:00:46,200 --> 00:00:51,000\n効率化なら電動バリカンが良いのかもしれません。",
      "1\n00:00:53,200 --> 00:00:58,000\nでも刈りバサミは気に入っています。\n当面はこれ一本で。",
      "1\n00:01:00,200 --> 00:01:07,000\n次はエビイモとサツマイモが混ざる協生エリアです。",
      "1\n00:01:09,200 --> 00:01:14,000\n伸びている草だけを刈っていきます。",
      "1\n00:01:30,200 --> 00:01:35,000\n草を全部なくさなくても",
      "2\n00:01:35,200 --> 00:01:40,000\n野菜が優勢になれば十分。",
      "3\n00:01:40,200 --> 00:01:45,000\nこれが今期の草管理の方針です。",
      "1\n00:08:00,200 --> 00:08:07,000\n畑の観察を続けます。",
      "1\n00:08:11,200 --> 00:08:16,000\nサツマイモは勢いがあります。\n葉を広げています。",
      "1\n00:08:17,200 --> 00:08:22,000\nこちらのゴーヤも伸びきました。",
      "2\n00:08:22,200 --> 00:08:27,000\nでも葉は小さめ。",
      "1\n00:08:29,200 --> 00:08:36,000\n支柱を建てましょう。\n４本の女竹を束ね、片端を縛りました。",
      "1\n00:08:36,200 --> 00:08:41,000\n先ほどのゴーヤのところまで戻ります。"
    ],
    "sha256": "0171c00c625c5328009585402c1a9092f57a7cd8dfbc8d267a4e679e95baa0da"
  },
  {
    "id": "n166",
    "title": "春の共生畑とミニトマト収穫期",
    "period": "2026年4月〜5月",
    "period_evidence": "本文に2026年春（4月〜5月）の様子と明記。",
    "representative_file": "n166ja.srt",
    "warnings": "",
    "excerpts": [
      "4\n00:00:29,200 --> 00:00:34,000\n畑に来るたびに整えています",
      "1\n00:00:38,200 --> 00:00:43,000\n自然農法で育つサツマイモを観察",
      "2\n00:00:43,200 --> 00:00:48,000\n葉は円のように広がっていくようです",
      "3\n00:00:48,200 --> 00:00:53,000\n葉の広がりに合わせて\n草をカットしてみます。",
      "4\n00:00:53,200 --> 00:00:58,000\nとりあえずの試行錯誤です",
      "1\n00:01:02,200 --> 00:01:07,000\nもう少し自然農法畑の中を観察します。",
      "4\n00:02:06,200 --> 00:02:11,000\n問題なく乗り越えました",
      "1\n00:02:12,773 --> 00:02:18,181\nサツマイモとゴーヤは安定してます。",
      "1\n00:02:19,039 --> 00:02:24,909\nミニトマトも当然のごとく順調。",
      "1\n00:02:25,502 --> 00:02:31,603\n積み重ねていた枯木の束も観察",
      "1\n00:02:35,200 --> 00:02:40,000\n枯木の下で分解が進んでいるようです。",
      "2\n00:02:40,200 --> 00:02:45,000\n糸状菌が見られます。",
      "1\n00:04:16,646 --> 00:04:22,153\nナスは半日陰、\nそして多めの草マルチが良さそう。",
      "1\n00:04:25,022 --> 00:04:33,134\nサツマイモは生き残る力が強いですが、\n芋の大きくするのが課題です。",
      "1\n00:04:33,959 --> 00:04:37,818\nコマツナは全て食べられました",
      "1\n00:04:41,478 --> 00:04:48,964\nしかしシカクマメが発芽し\n次の主役になりそうです",
      "1\n00:04:52,200 --> 00:04:57,000\n1mの共生区画では",
      "2\n00:04:57,200 --> 00:05:02,000\n養分の確保が重要になりそうです"
    ],
    "sha256": "976462c024f1ef8d6ebc06cbec08c530b06b3b1aabd6aa977408f6e59436beae"
  },
  {
    "id": "n165",
    "title": "春のヒューゲル畝とキュウリ初収穫",
    "period": "2026年4月上旬（年は推定）",
    "period_evidence": "冒頭「4月上旬」。年は更新年・前後の記録から推定。",
    "representative_file": "n165ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "3\n00:01:52,200 --> 00:01:56,500\n草の戻りは速いですけどね。",
      "1\n00:01:59,200 --> 00:02:01,000\n去年植え付けたサツマイモ。",
      "2\n00:02:01,200 --> 00:02:03,000\n草に覆われても生き延びていました。",
      "1\n00:02:09,200 --> 00:02:16,000\nそのまま育てましょう。\n周囲の草をはさみで整理します。",
      "1\n00:02:18,200 --> 00:02:23,000\nサツマイモまわりの草整理が終わりました。",
      "2\n00:02:23,200 --> 00:02:28,000\nサツマイモは \nかなり丈夫な作物ですが",
      "3\n00:02:28,200 --> 00:02:33,000\n放置だと芋が小さいのが問題。",
      "4\n00:02:33,200 --> 00:02:38,000\nとりあえず　まわりの草だけ整理して",
      "5\n00:02:38,200 --> 00:02:43,000\nツルが広がるようにしてみます。",
      "6\n00:02:43,200 --> 00:02:48,000\n自然農で芋を大きくする方法は\n今も試行錯誤中です。",
      "2\n00:07:57,200 --> 00:08:02,000\nまだ実をつける力が残っていそうです。",
      "1\n00:08:04,200 --> 00:08:09,000\nサツマイモの収穫は",
      "2\n00:08:09,200 --> 00:08:14,000\nまだ少し先になりそうです。",
      "3\n00:08:14,200 --> 00:08:19,000\nあと2か月ほど見ながら",
      "4\n00:08:19,200 --> 00:08:24,000\n葉が黄色くなるのを待ちます。",
      "1\n00:08:42,200 --> 00:08:47,000\nここからは猫たちの様子です。"
    ],
    "sha256": "dc143babf7d8a614ad92569425ce443f2c82260d37f64259873f5992635f8282"
  },
  {
    "id": "n161",
    "title": "1mの共生畑 第5回",
    "period": "2026年4月（年は推定）",
    "period_evidence": "冒頭「4月」。年は更新年・前後の記録から推定。",
    "representative_file": "n161ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "1\n00:04:39,200 --> 00:04:44,000\nさらに自然に生えてきたミニトマト",
      "1\n00:04:51,200 --> 00:04:56,000\nまだいきます、サツマイモのツル！",
      "1\n00:04:59,200 --> 00:05:04,000\nミックスタネの種類は多数で\n把握できていません",
      "2\n00:05:04,200 --> 00:05:09,000\n多くの種類をまとめて植えます",
      "1\n00:05:11,200 --> 00:05:16,000\n苗とタネをどんどん植えていきます",
      "1\n00:05:24,200 --> 00:05:29,000\nタネまきと植付が終わりました",
      "4\n00:06:48,200 --> 00:06:53,000\n続いてミニトマト、そしてゴーヤ。",
      "5\n00:06:53,200 --> 00:06:58,000\nナスやサツマイモは未知数\nシカクマメが育つかも。",
      "6\n00:06:58,200 --> 00:07:03,000\n年明けには\nショウガを収穫できるかもしれません。",
      "1\n00:07:05,200 --> 00:07:10,000\n5日後の様子です",
      "2\n00:07:10,200 --> 00:07:15,000\n大雨が続く日々でしたが苗は無事",
      "3\n00:07:15,200 --> 00:07:20,000\nコマツナが多く発芽しています"
    ],
    "sha256": "df1975af1bc5905ac2d01f667300e55f42a2bf804b2b732219a35e738baa3a5d"
  },
  {
    "id": "n156",
    "title": "1mの共生畑 第4回",
    "period": "2026年3月〜4月初旬頃",
    "period_evidence": "本文「前回に引き続き3月」「数日経過し4月」。年は更新日とシリーズ前後から推定。",
    "representative_file": "n156ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "1\n00:02:21,200 --> 00:02:25,000\nさらに数日後",
      "2\n00:02:25,200 --> 00:02:29,000\nナスはサツマイモにやや押されてます。",
      "1\n00:02:32,200 --> 00:02:37,000\nキュウリは回復してきました。",
      "1\n00:02:40,200 --> 00:02:45,000\nゴーヤはツルの伸ばし始めました。",
      "1\n00:02:46,200 --> 00:02:50,500\n同時期に定植したゴーヤと比較",
      "2\n00:02:50,700 --> 00:02:55,000\n草で囲んでいない\n従来の植え方のゴーヤです。",
      "2\n00:07:05,200 --> 00:07:10,000\n冬を越えた命が活発化。",
      "1\n00:07:13,200 --> 00:07:18,000\n先日草を剪定したサツマイモです",
      "1\n00:07:22,200 --> 00:07:26,500\nまだ実験を始めて間もなく",
      "2\n00:07:26,700 --> 00:07:31,000\n自然農では、\nまだ収穫に成功したことがありません。",
      "1\n00:07:34,200 --> 00:07:38,500\n現在、緊急防除になっている\nセグロウリミバエらしきハエを発見。",
      "2\n00:07:38,700 --> 00:07:43,000\n調べると「Dexia fulvifera Röder」\n...という未知のハエ。"
    ],
    "sha256": "6f830c5ea856a4f70a1b827b34902bfa67276a58afa1e7a41f1d9eaeb414698e"
  },
  {
    "id": "n155",
    "title": "1mの共生畑 第3回",
    "period": "2026年3月（年は推定）",
    "period_evidence": "冒頭「3月」。年は更新年・前後の記録から推定。",
    "representative_file": "n155ja.srt",
    "warnings": "翻訳・コピー・改訂版を含む／時期に推定を含む",
    "excerpts": [
      "3\n00:02:48,200 --> 00:02:53,000\nゆっくり成長しているようです",
      "1\n00:02:54,200 --> 00:02:58,500\n次はサツマイモ",
      "2\n00:02:58,700 --> 00:03:03,000\n昨年は草に埋もれて大失敗。",
      "3\n00:03:03,200 --> 00:03:07,500\n枯れはしませんでしたが、",
      "4\n00:03:07,700 --> 00:03:12,000\n収穫は小さな芋ばかり",
      "1\n00:03:14,200 --> 00:03:18,500\n今回は方針を変えて"
    ],
    "sha256": "4ed5f21ba1cc303ddb71ec96ab2a6ad504cdd70357dca411dd0293d96941d8a4"
  },
  {
    "id": "n154",
    "title": "1mの共生畑 第2回",
    "period": "2026年3月中旬（年は推定）",
    "period_evidence": "冒頭「3月中旬」。年は更新年・前後の記録から推定。",
    "representative_file": "n154ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "3\n00:05:33,200 --> 00:05:38,000\n根元からは再び葉野菜が発芽。",
      "1\n00:05:38,200 --> 00:05:42,500\nサツマイモの茎も移植してます。",
      "1\n00:05:45,200 --> 00:05:50,000\n1mの共生畑、\nその中でも最も古い区画です。",
      "2\n00:05:50,200 --> 00:05:55,000\nやはり目立って\n成長しているのはミニトマト。",
      "1\n00:05:56,200 --> 00:06:01,000\nゴーヤがやっと発芽しました。",
      "1\n00:06:03,200 --> 00:06:08,000\nマメ類も遅れながら発芽。"
    ],
    "sha256": "7421ed4f983b4fd8c2b176d92636c6754d24d441e2b9dc93a4040a681f43fc1c"
  },
  {
    "id": "n150",
    "title": "年末の畑と秋の自然観察",
    "period": "2025年12月下旬（回顧：9月中旬）",
    "period_evidence": "冒頭に2025年12月下旬、9月は回顧。番号順が逆でも本文を優先。",
    "representative_file": "n150ja.srt",
    "warnings": "",
    "excerpts": [
      "1\n00:00:25,200 --> 00:00:30,000\n年が明けて寒さの盛りに収穫できそうです。",
      "1\n00:00:34,200 --> 00:00:39,000\n古い品種のサツマイモ。",
      "2\n00:00:39,200 --> 00:00:44,000\n来季のため、ツルを生かして管理中。",
      "1\n00:00:49,200 --> 00:00:54,000\nシマトウガラシは収穫期。",
      "2\n00:00:54,200 --> 00:00:59,000\n数が少ないので種から株を増やさねば...",
      "1\n00:01:05,200 --> 00:01:10,000\nピラミッド型に仕立てたキュウリ。",
      "1\n00:06:38,200 --> 00:06:43,000\nずんぐりした体型のスズメガ。",
      "2\n00:06:43,200 --> 00:06:48,000\n幼虫はサツマイモやヒルガオの葉が好き。",
      "1\n00:06:53,200 --> 00:06:58,000\nイシガケチョウ。",
      "2\n00:06:58,200 --> 00:07:03,000\nさらに先へ進みます。",
      "1\n00:07:07,200 --> 00:07:10,000\nジャコウアゲハ？",
      "1\n00:07:11,200 --> 00:07:15,500\n胴体がオレンジ。ジャコウアゲハでしょう。"
    ],
    "sha256": "196d02f0fb7bbc67a9e11f8645819c9997fcfb2a07c4cba62c29ed4a80905295"
  },
  {
    "id": "n152",
    "title": "1mの共生畑 第1回",
    "period": "2025年11月末〜2026年3月",
    "period_evidence": "2025年11月末から12月、1月下旬、3月へ場面が進む。",
    "representative_file": "n152ja.srt",
    "warnings": "",
    "excerpts": [
      "1\n00:02:44,200 --> 00:02:49,000\n手が届く範囲だけで野菜を植えます。",
      "1\n00:02:51,200 --> 00:02:55,500\n古いキュウリの下のサツマイモ。",
      "2\n00:02:55,700 --> 00:03:00,000\n勝手に生えてきた\n自然生えのサツマイモです。",
      "1\n00:03:03,200 --> 00:03:07,500\nこの古いキュウリも利用します。",
      "1\n00:03:08,200 --> 00:03:13,000\n手の届く1m範囲内を草刈りし、\nミックスしたタネを落とします。",
      "1\n00:03:21,200 --> 00:03:26,000\n1年前くらい前に収穫した\nジャガイモのタネ芋、",
      "1\n00:03:29,200 --> 00:03:33,500\n先ほどの古いキュウリ。",
      "2\n00:03:33,700 --> 00:03:37,500\nあえて自然っぽく落としておきます。",
      "1\n00:03:38,200 --> 00:03:43,000\n自然生えのサツマイモも　\n大切に育てます。",
      "1\n00:03:45,200 --> 00:03:50,000\n最後に刈草をかぶせたら終わり。",
      "1\n00:03:59,200 --> 00:04:04,000\nもう一つ「1mの共生畑」を作ります。",
      "2\n00:04:04,200 --> 00:04:09,000\nこのナスの周りが　ちょうどよさそう。",
      "1\n00:04:10,200 --> 00:04:15,000\nまずは草を刈りましょう。"
    ],
    "sha256": "06cddf340b847092d287c0cf5ab103734a24372086e24a43b83595a8a378afde"
  },
  {
    "id": "n151",
    "title": "秋キュウリの栽培とピラミッド型支柱",
    "period": "2025年9月中旬〜11月末",
    "period_evidence": "本文に年と9月中旬、10月中旬・末、11月初旬・末。",
    "representative_file": "n151ja.srt",
    "warnings": "",
    "excerpts": [
      "2\n00:00:50,200 --> 00:00:55,000\n本当に久しぶりに来たのだと実感します。",
      "1\n00:00:59,200 --> 00:01:04,000\n数カ月前にサツマイモを植えた畝なのですが…。",
      "2\n00:01:04,200 --> 00:01:09,000\n草が茂りすぎて、\n畝がどこにあったのか分からないほどです。",
      "1\n00:01:10,200 --> 00:01:15,000\nサツマイモのツルが力強く畑を覆うはずでした。",
      "2\n00:01:15,200 --> 00:01:20,000\nところが現実は完全に、草に負けています。",
      "3\n00:01:20,200 --> 00:01:25,000\n草に隠れながらもヤマイモのツルが見つかりました。",
      "4\n00:01:25,200 --> 00:01:30,000\nショウガの株も草の合間からなんとか確認できます。",
      "1\n00:01:38,200 --> 00:01:43,000\n草に埋もれて、ほんの少しだけ\nサツマイモのツルが顔を出していました。",
      "2\n00:01:43,200 --> 00:01:48,000\nこんな弱々しさでは、芋の収穫は絶望的です。",
      "1\n00:01:49,200 --> 00:01:54,000\nまずは草刈機で、畑を覆う草を一気に刈ります。",
      "1\n00:02:24,200 --> 00:02:29,000\n作業の合間にほっと一息。",
      "2\n00:02:29,200 --> 00:02:34,000\nナナフシと戯れる小さな癒やし。"
    ],
    "sha256": "c8be5a4e32e961f234c6fba69a9d5ac6ad2ac47fd54507172b89e03681e51b36"
  },
  {
    "id": "n149",
    "title": "四脚支柱の増設と池の循環",
    "period": "2025年7月頃（更新日から推定）",
    "period_evidence": "主場面の月が明記されない。9月収穫予定は撮影月に採用しない。",
    "representative_file": "n149ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "5\n00:01:53,200 --> 00:01:58,000\nでは次の場所に移動します。",
      "1\n00:02:08,200 --> 00:02:13,000\nこの場所にはサツマイモを植えました。",
      "2\n00:02:13,200 --> 00:02:18,000\nでも今はもう、完全に草だらけ。",
      "3\n00:02:18,200 --> 00:02:23,000\nよく目を凝らすと、サツマイモの葉が見えます。",
      "4\n00:02:23,200 --> 00:02:28,000\n収穫は9月ごろを予定していますが、",
      "5\n00:02:28,200 --> 00:02:33,000\n実験なので、のんびり見守っています。",
      "1\n00:02:37,200 --> 00:02:42,000\n続いては収穫期に入ったシマトウガラシ。",
      "2\n00:02:42,200 --> 00:02:47,000\n相変わらず良い実りです。"
    ],
    "sha256": "9b5769ab85145fac66c47d13c50dea2803c80145b429c47b569fcabbdd54550f"
  },
  {
    "id": "n146",
    "title": "協生農法 第12回、ポンプなしのアクアポニックス",
    "period": "2025年4月〜5月初旬頃",
    "period_evidence": "3月・4月の気温の回顧と5月1日の発芽確認。年は更新日から推定。",
    "representative_file": "n146ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "3\n00:04:50,200 --> 00:04:55,000\n１つも発芽してくれません。",
      "1\n00:04:58,200 --> 00:05:03,000\n今年はサツマイモに力を入れています。",
      "2\n00:05:03,200 --> 00:05:08,000\n前回は適当に育ててしまい、",
      "3\n00:05:08,200 --> 00:05:13,000\n収穫のタイミングを見失いました。",
      "4\n00:05:13,200 --> 00:05:18,000\n今回はスケジュールを立てて育てます。",
      "1\n00:05:23,200 --> 00:05:28,000\nショウガも混植しましたが、まだ発芽せず。",
      "1\n00:07:01,200 --> 00:07:06,000\nシマトウガラシは花を咲かせました。",
      "1\n00:07:11,200 --> 00:07:16,000\nその隣でショウガとサツマイモも育てています。",
      "2\n00:07:16,200 --> 00:07:21,000\nただ、ショウガはまだ土の中。",
      "3\n00:07:21,200 --> 00:07:26,000\nここのショウガも発芽に時間がかかりそう。",
      "1\n00:07:27,200 --> 00:07:32,000\nちょっと奥の方も見てみましょう。",
      "2\n00:07:32,200 --> 00:07:37,000\n紫色の花が咲く謎の草の奥へ。",
      "3\n00:09:55,200 --> 00:10:00,000\n多様な植物が支え合っています。",
      "1\n00:10:03,200 --> 00:10:08,000\n隣の畝ではサツマイモと葉野菜を混植中。",
      "2\n00:10:08,200 --> 00:10:13,000\nこの時期の葉野菜は大きくならず、",
      "3\n00:10:13,200 --> 00:10:18,000\n小さいまま花を咲かせがちです。",
      "4\n00:10:18,200 --> 00:10:23,000\nそのぶん、サツマイモに期待しています。",
      "1\n00:10:25,200 --> 00:10:29,000\n複数の葉野菜の種を混ぜて蒔きましたが、",
      "2\n00:10:29,200 --> 00:10:33,000\nワサビリーフだけがなぜかよく育っています。",
      "1\n00:10:35,200 --> 00:10:40,000\n一応、コーヒーがこのエリアの主役。",
      "2\n00:10:40,200 --> 00:10:45,000\nまわりに多様な野菜があるおかげか、"
    ],
    "sha256": "3ead8e01352563648e00a5d966e6789541cab00e61edfbdc26d1ca4d1bf38051"
  },
  {
    "id": "n143",
    "title": "0から始める協生農法 第10回",
    "period": "2025年2月下旬〜3月（回顧：2024年12月）",
    "period_evidence": "冒頭2024年12月は回顧。主場面は2月下旬から3月。年跨ぎと更新日から推定。",
    "representative_file": "n143ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "3\n00:01:31,200 --> 00:01:36,000\nその間、頭の中では構想を練っていました。  ",
      "4\n00:01:36,200 --> 00:01:41,000\n考え出したのは、サツマイモ。  ",
      "5\n00:01:41,200 --> 00:01:46,000\n夏に強く、緊急的な食糧として優秀！",
      "1\n00:01:48,200 --> 00:01:53,000\n早速、草刈機をかけて整地。",
      "1\n00:01:54,200 --> 00:02:01,000\n草と共存するとはいえ、\n最初だけはしっかり草刈りします。",
      "1\n00:02:02,200 --> 00:02:07,000\n整地、完了しました。  ",
      "3\n00:02:12,200 --> 00:02:17,000\n協生農法では\nバラバラに植えがちなんですが、  ",
      "4\n00:02:17,200 --> 00:02:22,000\nサツマイモは、そうしたらダメ。",
      "5\n00:02:22,200 --> 00:02:27,000\nツルが伸び放題になり\n手が付けられなくなります。",
      "6\n00:02:27,200 --> 00:02:32,000\n「つる返し」作業とかたいへんです。",
      "7\n00:02:32,200 --> 00:02:37,000\nきちんと計画して植えます。  ",
      "1\n00:02:39,200 --> 00:02:44,000\nこの畝は6m弱あります。  ",
      "3\n00:02:49,200 --> 00:02:54,000\nショウガも間に混植します。  ",
      "4\n00:02:54,200 --> 00:02:59,000\nサツマイモのツルが、\nショウガのまわりを覆うイメージです。",
      "1\n00:03:03,200 --> 00:03:08,000\nシャベルを土に突き刺し、",
      "2\n00:03:08,200 --> 00:03:13,000\nできたすき間に種生姜を投げ込む。",
      "3\n00:03:13,200 --> 00:03:18,000\n土壌構造を壊さない植え方です。  ",
      "1\n00:03:39,200 --> 00:03:44,000\n生姜の植え付けが終わったので、  ",
      "2\n00:03:44,200 --> 00:03:49,000\n次はサツマイモのツルを探しにいきます。  ",
      "3\n00:03:49,200 --> 00:03:54,000\n前回、試しで植えたサツマイモ。",
      "4\n00:03:54,200 --> 00:03:59,000\n枯れずに延々と\n新しいツルを生やし続けています。",
      "5\n00:03:59,200 --> 00:04:04,000\nサツマイモって、ほんとにたくましい！  ",
      "6\n00:04:04,200 --> 00:04:09,000\nこのツル、実は友人の庭に自生してたもの。  ",
      "7\n00:04:09,200 --> 00:04:14,000\n半ば野生化していた固定種です。  ",
      "1\n00:04:19,200 --> 00:04:24,000\n20株分のツルを採取しました。",
      "2\n00:04:24,200 --> 00:04:29,000\nサツマイモはタネ代も無料なのですばらしい。",
      "1\n00:04:31,200 --> 00:04:36,000\n植え付けはショウガと同じ方法です。",
      "1\n00:04:41,200 --> 00:04:46,000\nサツマイモ、全部植え終えました！",
      "2\n00:04:46,200 --> 00:04:51,000\nまだ作業がありますが、今日はこの辺りで。",
      "1\n00:04:55,200 --> 00:05:00,000\n4日が経過しました。作業を再開します。",
      "2\n00:05:00,200 --> 00:05:05,000\nサツマイモのツルの様子はというと…  ",
      "3\n00:05:05,200 --> 00:05:10,000\n少ししおれていますが、心配いりません。  ",
      "4\n00:05:10,200 --> 00:05:15,000\n今日は、さらに葉野菜のタネを追加まきしてみます。",
      "1\n00:05:21,200 --> 00:05:30,000\nわさびリーフ、山東菜、モロヘイヤ、ふだん草、\nシマナ、春菊、サラダ菜、タアツァイ、\nシソ、ダイコン、ニンジン、コマツナ...",
      "1\n00:05:35,200 --> 00:05:40,000\nまずは、葉っぱ系の野菜タネだけをミックス。  ",
      "1\n00:07:24,200 --> 00:07:29,000\n5日後、さっそく様子を見に来ました。  ",
      "2\n00:07:29,200 --> 00:07:34,000\nしおれていたサツマイモが、  ",
      "3\n00:07:34,200 --> 00:07:39,000\n少しずつ元気を取り戻し始めています。 ",
      "1\n00:07:45,200 --> 00:07:50,000\n葉野菜の発芽も確認できました。",
      "1\n00:08:11,200 --> 00:08:16,000\n約一か月が経過しました。  ",
      "2\n00:08:16,200 --> 00:08:21,000\nこの3月は、思ったより寒い日が続きました。  ",
      "2\n00:08:29,200 --> 00:08:34,000\nなぜか、わさびリーフが主に育っています。  ",
      "1\n00:08:41,200 --> 00:08:46,000\nサツマイモは、しっかりした株になりました。",
      "2\n00:08:46,200 --> 00:08:51,000\n収穫は7月頃になるでしょう。",
      "1\n00:08:53,200 --> 00:08:58,000\n続いては、ダイコン。  ",
      "2\n00:08:58,200 --> 00:09:03,000\n収穫が遅れて、花を咲かせてしまった!",
      "3\n00:09:03,200 --> 00:09:08,000\nこれは大きな失敗です。  "
    ],
    "sha256": "4f7c44767a0ebe30dd28c02f44729475aa889bf3585e571865bb092b4c56f1dd"
  },
  {
    "id": "n129",
    "title": "冬の葉野菜と混植区画の観察",
    "period": "2024年12月中旬",
    "period_evidence": "冒頭「2024年12月中旬」。年月は本文に明記。",
    "representative_file": "n129ja.srt",
    "warnings": "",
    "excerpts": [
      "1\n00:07:27,200 --> 00:07:32,000\nオクラがタネ化してたので\n後ほど採取しました。",
      "1\n00:07:41,200 --> 00:07:47,000\nサツマイモの蔓も確認できます。\nしかし、芋は成ってないでしょう。",
      "1\n00:07:49,200 --> 00:07:55,000\nでもダイショの芋は成っているようです。",
      "2\n00:07:55,200 --> 00:08:01,000\n掘り起こしてみます。",
      "1\n00:08:10,200 --> 00:08:16,000\n大きな芋を掘り出しました。",
      "2\n00:08:16,200 --> 00:08:22,000\nダイショは地元で複数の呼び名があります。"
    ],
    "sha256": "00babe9b6d18e09a596d3c0bdabc884f43ac3e71b07f7d837ab0b522fb1658ef"
  },
  {
    "id": "n128",
    "title": "冬の混植とビーツ・カブの播種",
    "period": "2024年12月初旬〜中旬",
    "period_evidence": "冒頭に年と範囲を明記。",
    "representative_file": "n128ja.srt",
    "warnings": "",
    "excerpts": [
      "1\n00:08:43,200 --> 00:08:48,000\n草のカット作業が終わりました。",
      "2\n00:08:48,200 --> 00:08:53,000\nサツマイモの葉の隣に、",
      "3\n00:08:53,200 --> 00:08:58,000\n小さなハツダイコンの苗が確認できます。",
      "4\n00:08:58,200 --> 00:09:03,000\nしかし、ほとんどの場所で生えてません。",
      "5\n00:09:03,200 --> 00:09:08,000\n11下旬になれば発芽してくるかもと思い、",
      "6\n00:09:08,200 --> 00:09:13,000\nもう少し待ってみることにしたのですが...。"
    ],
    "sha256": "07a6feb9d210b02df027eb7289816ce7d219d1405eac3e23b1da0cd6f6fdecdd"
  },
  {
    "id": "n142",
    "title": "母の自然農畑、秋から春の収穫",
    "period": "2024年10月初旬〜2025年4月中旬",
    "period_evidence": "秋から年末、春へ連続する場面と4月中旬の追記。年は更新日・前後コードの記録から推定。",
    "representative_file": "n142ja.srt",
    "warnings": "翻訳・コピー・改訂版を含む／時期に推定を含む",
    "excerpts": [
      "5\n00:00:20,200 --> 00:00:25,000\nその間にも雑草がどんどん伸びていきます。",
      "6\n00:00:25,200 --> 00:00:30,000\nサツマイモが勝手に生えて野放し状態に。",
      "1\n00:00:32,200 --> 00:00:37,000\nしかし隣を見ると、雑草に埋もれた畝の中で…",
      "2\n00:00:37,200 --> 00:00:42,000\n何かが、ひっそりと実っていました。",
      "1\n00:00:43,200 --> 00:00:48,000\n夏の名残、枯れた赤ピーマンのそばを通っていくと…",
      "2\n00:00:48,200 --> 00:00:53,000\nその奥、地面を這う葉の下に",
      "4\n00:04:37,200 --> 00:04:42,000\n母の自然農は、この草堆肥が特徴です。",
      "1\n00:04:44,200 --> 00:04:48,500\n畑の草刈りの時に出てきたサツマイモ。",
      "2\n00:04:48,700 --> 00:04:53,000\nサツマイモは放置してても勝手に育ちます。",
      "1\n00:04:55,200 --> 00:05:00,000\n11月もやがて終わりなのに、",
      "2\n00:05:00,200 --> 00:05:05,000\nなんと! また、ゴーヤが実りました。",
      "3\n00:05:05,200 --> 00:05:10,000\n気候変動で暑さが長引いています。",
      "4\n00:05:10,200 --> 00:05:15,000\n夏野菜の期間を延長しなければ。"
    ],
    "sha256": "c5ef9c0181c826326031b4edaddf04ae3e16873c849a50ec3f65c9977cfa989d"
  },
  {
    "id": "n121",
    "title": "冬野菜への切り替えとトマト品種試験",
    "period": "2024年10月下旬〜11月初旬",
    "period_evidence": "冒頭の撮影範囲を採用。未来の収穫予定は除外。年は更新日から推定。",
    "representative_file": "n121ja.srt",
    "warnings": "時期に推定を含む",
    "excerpts": [
      "1\n00:02:09,200 --> 00:02:13,500\n草刈り機で草を刈り終えました。",
      "2\n00:02:13,700 --> 00:02:18,000\nサツマイモの株が生えています。",
      "1\n00:02:18,200 --> 00:02:22,500\n以前、他の野菜と一緒に植えたサツマイモですが、",
      "2\n00:02:22,700 --> 00:02:27,000\n同じ場所でずっと残り続けています。",
      "3\n00:02:27,200 --> 00:02:31,500\nしかし、これは失敗です。",
      "4\n00:02:31,700 --> 00:02:36,000\nもっと広い場所で計画的に育てる必要があります。",
      "1\n00:02:41,200 --> 00:02:45,500\n以前、ミニトマトの栽培していた古い支柱。",
      "1\n00:02:48,200 --> 00:02:52,000\nサツマイモですが、",
      "2\n00:02:52,200 --> 00:02:56,000\nまだ芋が成っている感じではありません。",
      "1\n00:02:58,200 --> 00:03:02,700\n試しに掘ってみましたが芋はありませんでした。",
      "1\n00:03:07,200 --> 00:03:11,000\nサツマイモの蔓を別の場所に移動しました。",
      "2\n00:03:11,200 --> 00:03:15,000\nとりあえずの維持管理です。",
      "1\n00:03:17,200 --> 00:03:21,500\n蔓に土を軽くかぶせました。",
      "2\n00:03:21,700 --> 00:03:26,000\n春になったら、ここから蔓を採取する予定です。",
      "1\n00:03:29,200 --> 00:03:33,500\n再び、先ほど草を刈った場所へ。"
    ],
    "sha256": "0b914a595cc9d5484fb1583d2fa5cd7cdd0f339df481b2d5758f02dc5c6bc4cd"
  },
  {
    "id": "n115",
    "title": "母の自然農畑、夏の四か月",
    "period": "2024年6月初旬〜9月中旬",
    "period_evidence": "四か月の記録。本文の場面表示に基づく。年は更新日から推定。",
    "representative_file": "n115ja.srt",
    "warnings": "翻訳・コピー・改訂版を含む／時期に推定を含む",
    "excerpts": [
      "3\n00:02:18,200 --> 00:02:22,500\n成長が弱い印象をうけます。",
      "1\n00:02:26,200 --> 00:02:29,700\n草の中ではサツマイモが育っています。",
      "1\n00:02:35,200 --> 00:02:39,500\nピーマンは実を付け始めました。",
      "1\n00:02:46,200 --> 00:02:50,500\nオクラも順調です。",
      "2\n00:02:50,700 --> 00:02:55,000\n同様に小さな実がなり始めました。",
      "1\n00:03:02,200 --> 00:03:06,500\n2週間ほど経過し、７月下旬になりました。",
      "2\n00:08:00,500 --> 00:08:04,600\n小ぶりですが良いゴーヤの実がなっています。",
      "1\n00:08:07,200 --> 00:08:11,300\n草の中で育つサツマイモ。",
      "1\n00:08:19,200 --> 00:08:23,300\n気づきませんでしたがミニトマトも育てていたようです。",
      "2\n00:08:23,500 --> 00:08:27,600\n支柱がないのであとでごちゃごちゃした感じになりそうです。",
      "1\n00:08:47,200 --> 00:08:51,300\n草の中で育つアカウリを観察します。",
      "1\n00:09:03,200 --> 00:09:07,300\n草の上を覆うように葉が伸びています。",
      "1\n00:12:15,200 --> 00:12:21,000\nゴーヤも同様、最初の収穫から50日間までのようです。\n収穫期を過ぎると成長が鈍化し、小さい葉ばかりになります。",
      "1\n00:12:23,200 --> 00:12:27,500\nサツマイモが良い感じに育っています。",
      "1\n00:12:28,200 --> 00:12:36,000\n収穫はあと2カ月間くらいかな。",
      "1\n00:12:45,200 --> 00:12:49,500\n次の収穫はアカウリになりそうです。",
      "1\n00:12:59,200 --> 00:13:03,500\nすでにアカウリの小さな実が成り始めています。",
      "1\n00:13:06,200 --> 00:13:10,500\nピーマンは、まだ実を付けているものの、そろそろ終わりそうです。"
    ],
    "sha256": "9547bdc9029ed4d094f51745cfeecd5e3677900d578a69d834157934836c7609"
  },
